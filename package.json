{
  "name": "guttered",
  "displayName": "Guttered",
  "icon": "assets/icon.png",
  "description": "Distinct branch-change shading alongside native local Git markers, with inline merge-base diff previews.",
  "version": "0.4.5",
  "publisher": "nathangerday",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nathangerday/guttered.git"
  },
  "homepage": "https://github.com/nathangerday/guttered#readme",
  "bugs": {
    "url": "https://github.com/nathangerday/guttered/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "gutter",
    "branch",
    "merge-base",
    "diff"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies",
    "publish:marketplace": "vsce publish --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "guttered.toggle",
        "title": "Guttered: Toggle On/Off",
        "icon": "$(circle-slash)"
      },
      {
        "command": "guttered.showChangedFiles",
        "title": "Guttered: Show Changed Files",
        "icon": "$(list-tree)"
      },
      {
        "command": "guttered.actions",
        "title": "Guttered: Comparison Actions",
        "icon": "$(git-compare)"
      },
      {
        "command": "guttered.refresh",
        "title": "Guttered: Refresh Comparison",
        "icon": "$(refresh)"
      },
      {
        "command": "guttered.changeBase",
        "title": "Guttered: Change Base Reference",
        "icon": "$(git-branch)"
      },
      {
        "command": "guttered.openDiff",
        "title": "Guttered: Open Diff with Merge Base",
        "icon": "$(git-compare)"
      },
      {
        "command": "guttered.peekChange",
        "title": "Guttered: Peek Change",
        "icon": "$(eye)"
      },
      {
        "command": "guttered.nextChange",
        "title": "Guttered: Go to Next Change"
      },
      {
        "command": "guttered.previousChange",
        "title": "Guttered: Go to Previous Change"
      },
      {
        "command": "guttered.restoreChange",
        "title": "Guttered: Restore Change from Merge Base"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "guttered.changedFiles",
          "name": "Guttered: Branch Changes"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "guttered.toggle",
          "when": "view == guttered.changedFiles",
          "group": "navigation@1"
        },
        {
          "command": "guttered.changeBase",
          "when": "view == guttered.changedFiles",
          "group": "navigation@2"
        },
        {
          "command": "guttered.refresh",
          "when": "view == guttered.changedFiles",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "submenu": "guttered.context",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@20"
        }
      ],
      "guttered.context": [
        {
          "command": "guttered.peekChange",
          "group": "1_compare@1"
        },
        {
          "command": "guttered.openDiff",
          "group": "1_compare"
        },
        {
          "command": "guttered.nextChange",
          "group": "2_navigate"
        },
        {
          "command": "guttered.previousChange",
          "group": "2_navigate"
        },
        {
          "command": "guttered.restoreChange",
          "group": "3_restore"
        }
      ]
    },
    "submenus": [
      {
        "id": "guttered.context",
        "label": "Guttered"
      }
    ],
    "configuration": {
      "title": "Guttered",
      "properties": {
        "guttered.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Continuously compare editors with the branch's merge base."
        },
        "guttered.baseReference": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional Git reference override. Leave empty to detect the remote default branch (origin, or the first remote). All comparisons use the merge base with HEAD."
        },
        "guttered.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "maximum": 2000,
          "scope": "resource",
          "description": "Delay in milliseconds before updating indicators after edits."
        },
        "guttered.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "maximum": 10240,
          "scope": "resource",
          "description": "Skip comparisons when either file exceeds this size in KiB. Very complex diffs also have a time limit."
        },
        "guttered.gutter": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Shade committed branch-change lines without changing text layout. Local edits keep native Git gutter markers. Overview markers and commands remain available when disabled."
        },
        "guttered.overviewRuler": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show violet branch-change markers in the right-hand lane of the editor overview ruler."
        },
        "guttered.opacity": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 1,
          "scope": "resource",
          "description": "Intensity of branch indicators. Borders and overview markers use this opacity; line backgrounds use 40% of it (12% by default), keeping native local Git bars stronger."
        },
        "guttered.colors.branch": {
          "type": "string",
          "default": "#8B5CF6",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "scope": "resource",
          "description": "Color of committed branch shading, deletion boundaries and overview markers (hex RGB). Distinct from native Git local-change colors."
        }
      }
    },
    "keybindings": [
      {
        "command": "guttered.peekChange",
        "key": "ctrl+k ctrl+alt+d",
        "mac": "cmd+k cmd+alt+d",
        "when": "editorTextFocus && resourceScheme == file && !isInDiffEditor"
      }
    ]
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
