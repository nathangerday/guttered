{
  "name": "guttered",
  "displayName": "Guttered",
  "icon": "assets/icon.png",
  "description": "Live gutter indicators for your branch's changes since its merge base, including unsaved edits.",
  "version": "0.7.1",
  "publisher": "nathangerday",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nathangerday/guttered.git"
  },
  "homepage": "https://github.com/nathangerday/guttered#readme",
  "bugs": {
    "url": "https://github.com/nathangerday/guttered/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "gutter",
    "branch",
    "merge-base",
    "diff"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies",
    "publish:marketplace": "vsce publish --no-dependencies",
    "package:workbench": "npm run build && cd workbench-extension && vsce package --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "guttered.toggle",
        "title": "Guttered: Toggle On/Off",
        "icon": "$(circle-slash)"
      },
      {
        "command": "guttered.showChangedFiles",
        "title": "Guttered: Show Changed Files",
        "icon": "$(list-tree)"
      },
      {
        "command": "guttered.openFile",
        "title": "Guttered: Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "guttered.actions",
        "title": "Guttered: Comparison Actions",
        "icon": "$(git-compare)"
      },
      {
        "command": "guttered.refresh",
        "title": "Guttered: Refresh Comparison",
        "icon": "$(refresh)"
      },
      {
        "command": "guttered.changeBase",
        "title": "Guttered: Change Base Reference",
        "icon": "$(git-branch)"
      },
      {
        "command": "guttered.previewChange",
        "title": "Guttered: Preview Change with Merge Base",
        "icon": "$(diff)"
      },
      {
        "command": "guttered.openDiff",
        "title": "Guttered: Open Diff with Merge Base",
        "icon": "$(git-compare)"
      },
      {
        "command": "guttered.nextChange",
        "title": "Guttered: Go to Next Change"
      },
      {
        "command": "guttered.previousChange",
        "title": "Guttered: Go to Previous Change"
      },
      {
        "command": "guttered.restoreChange",
        "title": "Guttered: Restore Change from Merge Base"
      },
      {
        "command": "guttered.enableWorkbenchInjection",
        "title": "Guttered: Enable Gutter Clicks (Experimental)"
      },
      {
        "command": "guttered.disableWorkbenchInjection",
        "title": "Guttered: Disable Gutter Clicks and Restore Workbench"
      },
      {
        "command": "guttered.workbenchInjectionStatus",
        "title": "Guttered: Gutter Clicks Status"
      },
      {
        "command": "guttered.selectDiffView",
        "title": "Guttered: Select Diff View",
        "icon": "$(inspect)"
      },
      {
        "command": "guttered.copyChangePatch",
        "title": "Guttered: Copy Change Patch",
        "icon": "$(copy)"
      },
      {
        "command": "guttered.openWorkingFile",
        "title": "Guttered: Open Working File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "guttered.openFileDiff",
        "title": "Guttered: Open File Diff"
      },
      {
        "command": "guttered.restoreQuickDiff",
        "title": "Guttered: Revert Change",
        "icon": "$(discard)"
      },
      {
        "command": "guttered.copyQuickDiffPatch",
        "title": "Guttered: Copy Patch",
        "icon": "$(copy)"
      },
      {
        "command": "guttered.openQuickDiffFull",
        "title": "Guttered: Full Diff",
        "icon": "$(diff)"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "guttered.changedFiles",
          "name": "Guttered: Branch Changes"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "guttered.openFile",
          "when": "false"
        },
        {
          "command": "guttered.openFileDiff",
          "when": "false"
        },
        {
          "command": "guttered.restoreQuickDiff",
          "when": "false"
        },
        {
          "command": "guttered.copyQuickDiffPatch",
          "when": "false"
        },
        {
          "command": "guttered.openQuickDiffFull",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "guttered.openFile",
          "when": "view == guttered.changedFiles && viewItem == gutteredFile",
          "group": "inline@1"
        }
      ],
      "view/title": [
        {
          "command": "guttered.toggle",
          "when": "view == guttered.changedFiles",
          "group": "navigation@1"
        },
        {
          "command": "guttered.changeBase",
          "when": "view == guttered.changedFiles",
          "group": "navigation@2"
        },
        {
          "command": "guttered.refresh",
          "when": "view == guttered.changedFiles",
          "group": "navigation@3"
        },
        {
          "command": "guttered.selectDiffView",
          "when": "view == guttered.changedFiles",
          "group": "navigation@4"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "guttered.previewChange",
          "when": "editorLineNumber in guttered.markedLines && (resourceScheme == file || resourceScheme == vscode-remote)",
          "group": "9_guttered@1"
        },
        {
          "command": "guttered.openDiff",
          "when": "editorLineNumber in guttered.markedLines && (resourceScheme == file || resourceScheme == vscode-remote)",
          "group": "9_guttered@2"
        },
        {
          "command": "guttered.restoreChange",
          "when": "editorLineNumber in guttered.markedLines && (resourceScheme == file || resourceScheme == vscode-remote)",
          "group": "9_guttered@3"
        },
        {
          "command": "guttered.copyChangePatch",
          "when": "editorLineNumber in guttered.markedLines && (resourceScheme == file || resourceScheme == vscode-remote)",
          "group": "9_guttered@4"
        }
      ],
      "editor/context": [
        {
          "submenu": "guttered.context",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "9_cutcopypaste@20"
        }
      ],
      "guttered.context": [
        {
          "command": "guttered.previewChange",
          "group": "1_compare@1"
        },
        {
          "command": "guttered.openDiff",
          "group": "1_compare@2"
        },
        {
          "command": "guttered.nextChange",
          "group": "2_navigate"
        },
        {
          "command": "guttered.previousChange",
          "group": "2_navigate"
        },
        {
          "command": "guttered.restoreChange",
          "group": "3_restore"
        },
        {
          "command": "guttered.copyChangePatch",
          "group": "3_restore@2"
        },
        {
          "command": "guttered.selectDiffView",
          "group": "4_view"
        }
      ],
      "editor/title": [
        {
          "command": "guttered.copyChangePatch",
          "when": "guttered.nativeDiff",
          "group": "navigation@1"
        },
        {
          "command": "guttered.openWorkingFile",
          "when": "guttered.nativeDiff",
          "group": "navigation@2"
        }
      ],
      "scm/change/title": [
        {
          "command": "guttered.restoreQuickDiff",
          "when": "originalResourceScheme == guttered-base",
          "group": "navigation@1"
        },
        {
          "command": "guttered.copyQuickDiffPatch",
          "when": "originalResourceScheme == guttered-base",
          "group": "navigation@2"
        },
        {
          "command": "guttered.openQuickDiffFull",
          "when": "originalResourceScheme == guttered-base",
          "group": "navigation@3"
        }
      ]
    },
    "submenus": [
      {
        "id": "guttered.context",
        "label": "Guttered"
      }
    ],
    "configuration": {
      "title": "Guttered",
      "properties": {
        "guttered.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Continuously compare editors with the branch's merge base."
        },
        "guttered.baseReference": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional Git reference override. Leave empty to detect the remote default branch (origin, or the first remote). All comparisons use the merge base with HEAD."
        },
        "guttered.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "maximum": 2000,
          "scope": "resource",
          "description": "Delay in milliseconds before updating indicators after edits."
        },
        "guttered.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "maximum": 10240,
          "scope": "resource",
          "description": "Skip comparisons when either file exceeds this size in KiB. Very complex diffs also have a time limit."
        },
        "guttered.gutter": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Show change markers beside the code, placed by `#guttered.gutterPlacement#`. Overview markers and actions remain available when disabled."
        },
        "guttered.hoverAction": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show a compact Open change diff action when hovering over changed code. Opens the selected Guttered diff view."
        },
        "guttered.gutterPlacement": {
          "type": "string",
          "default": "glyphMargin",
          "enum": [
            "glyphMargin",
            "inset"
          ],
          "enumDescriptions": [
            "The glyph margin, beside breakpoints. Clicking a changed line there does not add a breakpoint; right-click the gutter or press F9 instead. Hover the changed code to open the selected diff view; glyphs have no hover preview.",
            "A small inset before the text. Breakpoint clicks and other gutter controls stay free, and hovering a marker previews the change."
          ],
          "scope": "resource",
          "description": "Where change markers appear. Right-click a marked line's number or glyph margin for Guttered actions in either placement."
        },
        "guttered.overviewRuler": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show change markers in the editor overview ruler."
        },
        "guttered.colors.added": {
          "type": "string",
          "default": "#4CAF50",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "scope": "resource",
          "description": "Color of added lines (hex RGB)."
        },
        "guttered.colors.modified": {
          "type": "string",
          "default": "#E6A817",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "scope": "resource",
          "description": "Color of modified lines (hex RGB)."
        },
        "guttered.colors.deleted": {
          "type": "string",
          "default": "#F44336",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "scope": "resource",
          "description": "Color of deletion positions (hex RGB)."
        },
        "guttered.opacity": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 1,
          "scope": "resource",
          "description": "Opacity of Guttered markers, including the overview ruler. 0 is invisible and 1 is fully opaque; the default keeps native Git indicators more prominent."
        },
        "guttered.workbenchInjection": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Experimental left-click support for Guttered glyph-margin markers. Requires a writable desktop VS Code client. Enable in a local client window first to use it in WSL/SSH/containers, or install the matching Guttered Remote/WSL Helper locally to install and restore from remote windows. Use **Guttered: Enable Gutter Clicks (Experimental)** to install the client hook, then reload. The hook modifies a VS Code file and may cause an installation-integrity warning. Use **Disable Gutter Clicks and Restore Workbench** before uninstalling. Setting this to false stops handling but does not restore the file.",
          "ignoreSync": true
        },
        "guttered.diffView": {
          "type": "string",
          "enum": [
            "native",
            "quickDiff"
          ],
          "default": "native",
          "scope": "resource",
          "enumDescriptions": [
            "Open VS Code’s native diff editor at the selected line. Uses installed language grammars and the normal diff layout settings.",
            "Experimental native inline preview. Adds a merge-base Quick Diff provider alongside Git; use the preview’s base selector when changes overlap."
          ],
          "markdownDescription": "Diff view opened by changed-code hovers, glyph clicks, and Preview Change. Quick Diff shares VS Code’s change-indicator gutter and colors with Git, and appears as an additional Source Control provider. Its preview command uses a built-in editor command; select Guttered in the base selector when Git opens first."
        }
      }
    }
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
