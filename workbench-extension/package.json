{
  "name": "guttered-workbench",
  "displayName": "Guttered Remote/WSL Helper",
  "icon": "icon.png",
  "description": "Optional desktop helper for Guttered glyph clicks in WSL and other remote workspaces.",
  "version": "0.7.1",
  "publisher": "nathangerday",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nathangerday/guttered.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm --prefix .. run check && npm --prefix .. run build"
  },
  "contributes": {
    "commands": [
      {
        "command": "guttered.workbench.connect",
        "title": "Guttered Remote/WSL Helper: Connect Gutter Click Bridge"
      },
      {
        "command": "guttered.workbench.disconnect",
        "title": "Guttered Remote/WSL Helper: Disconnect Gutter Click Bridge"
      },
      {
        "command": "guttered.workbench.enable",
        "title": "Guttered Remote/WSL Helper: Install Gutter Click Hook"
      },
      {
        "command": "guttered.workbench.disable",
        "title": "Guttered Remote/WSL Helper: Restore Workbench"
      },
      {
        "command": "guttered.workbench.status",
        "title": "Guttered Remote/WSL Helper: Bridge Status"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "guttered.workbench.connect",
          "when": "false"
        },
        {
          "command": "guttered.workbench.disconnect",
          "when": "false"
        },
        {
          "command": "guttered.workbench.enable",
          "when": "false"
        },
        {
          "command": "guttered.workbench.disable",
          "when": "false"
        },
        {
          "command": "guttered.workbench.status",
          "when": "false"
        }
      ]
    }
  }
}
